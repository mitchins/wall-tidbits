TIMEZONE=Australia/Sydney
CONTACT_EMAIL=you@example.com
PUBLIC_TOKEN=replace-with-32-plus-random-hex-chars
RIDDLE_SEED=replace-with-a-random-secret
CONTENT_FILTER=family
FETCH_TIMEOUT=20
RETENTION_DAYS=30
# Use wall-tidbits:local for a local build, or the GHCR image on a LAN host.
WALL_TIDBITS_IMAGE=wall-tidbits:local
# Set these to the owner of the host data directory when it is not UID/GID 1000.
WALL_TIDBITS_UID=1000
WALL_TIDBITS_GID=1000
PORT=8080
